<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/crimeDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crime Title" />

        <TextView
            android:id="@+id/crimeDetailDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crime Date" />

        <CheckBox
            android:id="@+id/crimeDetailSolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solved" />

        <Button
            android:id="@+id/deleteCrimeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Crime" />

        <Button
            android:id="@+id/shareCrimeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share Crime" />

        <ImageView
            android:id="@+id/crimeDetailPhoto"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Crime photo" />

    </LinearLayout>

</ScrollView>
